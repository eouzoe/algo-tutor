{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioi-forge.local/schema/problem-spec.json",
  "title": "ioi-forge Problem Specification",
  "description": "Schema for training problems in the ioi-forge system",

  "type": "object",
  "required": ["id", "type", "statement", "constraints", "difficulty"],
  "properties": {
    "id": { "type": "string", "description": "Unique identifier" },
    "type": {
      "enum": ["pattern_recognition", "problem_analysis", "static_analysis", "debugging", "muscle_memory", "strategy", "optimization"],
      "description": "Which training subsystem this problem belongs to"
    },
    "statement": { "type": "string", "description": "Problem statement shown to student" },
    "constraints": {
      "type": "object",
      "required": ["n_range"],
      "properties": {
        "n_range": { "type": "string" },
        "time_limit": { "type": "string" },
        "memory_limit": { "type": "string" },
        "other": { "type": "array", "items": { "type": "string" } }
      }
    },
    "difficulty": {
      "type": "integer", "minimum": 1, "maximum": 5,
      "description": "1=recall, 2=comprehension, 3=application, 4=analysis, 5=synthesis"
    },
    "target_patterns": {
      "type": "array", "items": { "type": "string" },
      "description": "Pattern IDs this problem trains"
    },
    "target_concepts": {
      "type": "array", "items": { "type": "string" },
      "description": "Concept IDs required to solve"
    },
    "triggers": {
      "type": "array", "items": { "type": "string" },
      "description": "Keywords that should activate this pattern"
    },
    "solution": {
      "type": "object",
      "properties": {
        "approach": { "type": "string" },
        "complexity": { "type": "string" },
        "code": { "type": "string" },
        "reasoning_chain": { "type": "string", "description": "LLM thinking process template" }
      }
    },
    "rubric": {
      "type": "object",
      "description": "Grading criteria per level",
      "properties": {
        "L1": { "type": "string" },
        "L2": { "type": "string" },
        "L3": { "type": "string" },
        "L4": { "type": "string" }
      }
    },
    "variants": {
      "type": "array", "items": { "type": "string" },
      "description": "IDs of variant problems generated from this anchor"
    },
    "source": { "type": "string", "description": "Original source (cses/cf/atcoder/zj)" }
  }
}
