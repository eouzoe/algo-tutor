{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioi-forge.local/schema/rubric-spec.json",
  "title": "ioi-forge Rubric Specification",
  "description": "Grading rubrics for each training subsystem",

  "type": "object",
  "required": ["subsystem", "levels"],
  "properties": {
    "subtype": {
      "enum": ["pattern_recognition", "problem_analysis", "static_analysis", "debugging", "muscle_memory", "strategy", "optimization"]
    },
    "levels": {
      "type": "object",
      "description": "L1=recall, L2=comprehension, L3=application, L4=analysis, L5=synthesis",
      "properties": {
        "L1": { "$ref": "#/$defs/level" },
        "L2": { "$ref": "#/$defs/level" },
        "L3": { "$ref": "#/$defs/level" },
        "L4": { "$ref": "#/$defs/level" },
        "L5": { "$ref": "#/$defs/level" }
      }
    },
    "passing_threshold": {
      "type": "string",
      "description": "Minimum level to consider 'passed' (e.g., L3)"
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "required": ["description", "criteria"],
      "properties": {
        "description": { "type": "string" },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "example_response": { "type": "string" }
      }
    }
  }
}
