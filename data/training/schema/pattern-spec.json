{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioi-forge.local/schema/pattern-spec.json",
  "title": "ioi-forge Pattern Specification",
  "description": "Schema for problem-solving patterns (題型)",

  "type": "object",
  "required": ["id", "name", "triggers", "solution_template"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": {
      "enum": ["implementation", "greedy", "dp", "graph", "math", "string", "geometry", "data_structure", "search", "ad_hoc"],
      "description": "High-level domain"
    },
    "triggers": {
      "type": "array", "items": { "type": "string" },
      "minItems": 3,
      "description": "Keywords/signals that indicate this pattern"
    },
    "solution_template": {
      "type": "object",
      "properties": {
        "framework": { "type": "string", "description": "Step-by-step solution approach" },
        "complexity": { "type": "string" },
        "key_insight": { "type": "string", "description": "The one idea that cracks the problem" },
        "common_pitfalls": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requires": {
      "type": "array", "items": { "type": "string" },
      "description": "Concept/pattern IDs required before learning this"
    },
    "enables": {
      "type": "array", "items": { "type": "string" },
      "description": "Pattern IDs this unlocks"
    },
    "variant_of": { "type": "string", "description": "Parent pattern if this is a variant" },
    "similar_to": { "type": "array", "items": { "type": "string" } },
    "reasoning_chain_template": {
      "type": "string",
      "description": "Template for LLM to demonstrate thinking process"
    },
    "mastery_indicator": {
      "type": "string",
      "description": "How to know if student has mastered this pattern"
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "units": { "type": "array", "items": { "type": "integer" } }
  }
}
