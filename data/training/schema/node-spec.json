{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algo-tutor.local/schema/node-spec.json",
  "title": "algo-tutor Knowledge Graph Node Specification",
  "description": "Schema for knowledge graph nodes (concepts, patterns, templates, errors, strategies)",

  "type": "object",
  "required": ["id", "name", "type", "description"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": {
      "enum": ["concept", "pattern", "template", "technique", "strategy", "error_pattern", "trigger", "mental_model"]
    },
    "description": { "type": "string" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "abstraction_layers": { "type": "integer", "minimum": 1, "maximum": 5 },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "enables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rel"],
        "properties": {
          "id": { "type": "string" },
          "rel": { "enum": ["alternative", "deeper", "implementation", "analogous", "detail", "systems"] },
          "reason": { "type": "string" }
        }
      }
    },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "common_mistakes": { "type": "array", "items": { "type": "string" } },
    "mental_demands": {
      "type": "object",
      "properties": {
        "abstraction": { "type": "integer", "minimum": 1, "maximum": 5 },
        "spatial_reasoning": { "type": "integer", "minimum": 1, "maximum": 5 },
        "working_memory": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "units": { "type": "array", "items": { "type": "integer" } },
    "mastery_indicator": { "type": "string" }
  }
}
