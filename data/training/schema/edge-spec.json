{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algo-tutor.local/schema/edge-spec.json",
  "title": "algo-tutor Knowledge Graph Edge Specification",
  "description": "Schema for edges between knowledge graph nodes",

  "type": "object",
  "required": ["from", "to", "type"],
  "properties": {
    "from": { "type": "string", "description": "Source node ID" },
    "to": { "type": "string", "description": "Target node ID" },
    "type": {
      "enum": [
        "requires",
        "enables",
        "alternative",
        "generalizes",
        "instantiates",
        "analogous",
        "prerequisite_for_pattern",
        "common_combo",
        "confused_with",
        "variant_of",
        "similar_to",
        "composes"
      ]
    },
    "reason": { "type": "string", "description": "Why this edge exists" },
    "strength": {
      "type": "number", "minimum": 0, "maximum": 1,
      "description": "How strong the relationship is (for pathfinding)"
    }
  }
}
